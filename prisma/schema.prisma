generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MessageRole {
  user
  assistant

  @@map("agent_message_role")
}

enum LeadRequestType {
  CONSULTATION
  QUOTE
  SUPPORT
  APPOINTMENT
  OTHER

  @@map("agent_lead_request_type")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED

  @@map("agent_lead_status")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED

  @@map("agent_booking_status")
}

model Conversation {
  id        String    @id @default(cuid())
  sessionId String    @unique
  language  String?
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([leadId])
  @@index([createdAt])
  @@map("agent_conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

model Lead {
  id                 String          @id @default(cuid())
  name               String
  whatsappNumber     String
  email              String?
  companyName        String?
  requestType        LeadRequestType
  projectType        String?
  projectDescription String?         @db.Text
  requirements       String?         @db.Text
  existingSystem     String?
  budgetRange        String?
  expectedStart      String?
  consentGiven       Boolean         @default(false)
  consentAt          DateTime?
  status             LeadStatus      @default(NEW)
  notifiedAt         DateTime?
  conversations      Conversation[]
  bookings           Booking[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([whatsappNumber])
  @@map("agent_leads")
}

model Booking {
  id                  String        @id @default(cuid())
  leadId              String
  lead                Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  startsAt            DateTime
  endsAt              DateTime
  status              BookingStatus @default(PENDING)
  customerNote        String?       @db.Text
  decidedAt           DateTime?
  alternativeProposal String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Partial unique index preventing double-booking on active (PENDING/CONFIRMED) slots
  // is enforced in prisma/migrations/20261124000100_init_ai_agent/migration.sql:
  // CREATE UNIQUE INDEX "agent_bookings_startsAt_active_key" ON "agent_bookings"("startsAt") WHERE "status" IN ('PENDING', 'CONFIRMED');
  @@index([leadId])
  @@index([startsAt, status])
  @@map("agent_bookings")
}

model AvailabilityRule {
  id        String   @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, startTime, endTime])
  @@index([dayOfWeek, active])
  @@map("agent_availability_rules")
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@map("agent_blocked_dates")
}

model ProcessedWebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("agent_processed_webhook_events")
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @default(now()) @updatedAt

  @@index([expiresAt])
  @@map("agent_rate_limits")
}

model AgentRuntimeSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("agent_runtime_settings")
}
