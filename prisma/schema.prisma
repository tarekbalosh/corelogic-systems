generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MessageRole {
  user
  assistant

  @@map("agent_message_role")
}

enum LeadRequestType {
  CONSULTATION
  QUOTE
  SUPPORT
  APPOINTMENT
  OTHER

  @@map("agent_lead_request_type")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED

  @@map("agent_lead_status")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED

  @@map("agent_booking_status")
}

model Conversation {
  id        String    @id @default(cuid())
  sessionId String    @unique
  language  String?
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([leadId])
  @@index([createdAt])
  @@map("agent_conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

model Lead {
  id                 String            @id @default(cuid())
  name               String
  whatsappNumber     String
  email              String?
  companyName        String?
  requestType        LeadRequestType
  projectType        String?
  projectDescription String?           @db.Text
  requirements       String?           @db.Text
  existingSystem     String?
  budgetRange        String?
  expectedStart      String?
  consentGiven       Boolean           @default(false)
  consentAt          DateTime?
  status             LeadStatus        @default(NEW)
  notifiedAt         DateTime?
  conversations      Conversation[]
  bookings           Booking[]
  billingCustomers   BillingCustomer[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([whatsappNumber])
  @@map("agent_leads")
}

model Booking {
  id                  String            @id @default(cuid())
  leadId              String
  lead                Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  startsAt            DateTime
  endsAt              DateTime
  status              BookingStatus     @default(PENDING)
  customerNote        String?           @db.Text
  decidedAt           DateTime?
  alternativeProposal String?           @db.Text
  billingCustomers    BillingCustomer[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Partial unique index preventing double-booking on active (PENDING/CONFIRMED) slots
  // is enforced in prisma/migrations/20261124000100_init_ai_agent/migration.sql:
  // CREATE UNIQUE INDEX "agent_bookings_startsAt_active_key" ON "agent_bookings"("startsAt") WHERE "status" IN ('PENDING', 'CONFIRMED');
  @@index([leadId])
  @@index([startsAt, status])
  @@map("agent_bookings")
}

model AvailabilityRule {
  id        String   @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, startTime, endTime])
  @@index([dayOfWeek, active])
  @@map("agent_availability_rules")
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@map("agent_blocked_dates")
}

model ProcessedWebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("agent_processed_webhook_events")
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @default(now()) @updatedAt

  @@index([expiresAt])
  @@map("agent_rate_limits")
}

model AgentRuntimeSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("agent_runtime_settings")
}

// ============================================================================
// German Invoicing Module (GoBD-compliant, EN 16931 / E-Rechnung ready)
// ============================================================================

enum InvoiceType {
  INVOICE
  CANCELLATION

  @@map("invoicing_invoice_type")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED

  @@map("invoicing_invoice_status")
}

enum TaxTreatment {
  STANDARD_19
  REDUCED_7
  ZERO_RATED
  KLEINUNTERNEHMER
  REVERSE_CHARGE
  EXEMPT_NON_EU

  @@map("invoicing_tax_treatment")
}

enum InvoiceAuditAction {
  CREATED
  UPDATED
  ISSUED
  PDF_DOWNLOADED
  PAYMENT_RECORDED
  CANCELLED
  STORNO_CREATED
  LEAD_DELETION_BLOCKED

  @@map("invoicing_audit_action")
}

model CompanySettings {
  id                      String       @id @default("default")
  legalName               String       @default("CoreLogic Systems UG (haftungsbeschränkt)")
  street                  String       @default("")
  postalCode              String       @default("")
  city                    String       @default("")
  country                 String       @default("DE")
  managingDirector        String       @default("Tarek Balosh")
  registerCourt           String       @default("")
  registerNumber          String       @default("")
  taxNumber               String       @default("")
  vatId                   String       @default("")
  email                   String       @default("")
  phone                   String       @default("")
  website                 String       @default("")
  bankAccountHolder       String       @default("")
  bankIban                String       @default("")
  bankBic                 String       @default("")
  bankName                String       @default("")
  logoPath                String       @default("/corelogic_logo.png")
  defaultPaymentTermsDays Int          @default(14)
  defaultTaxTreatment     TaxTreatment @default(STANDARD_19)
  kleinunternehmerNotice  String       @db.Text
  reverseChargeNotice     String       @db.Text
  exemptNonEuNotice       String       @db.Text
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@map("invoicing_company_settings")
}

model BillingCustomer {
  id             String    @id @default(cuid())
  customerNumber String?   @unique
  name           String
  companyName    String?
  contactPerson  String?
  street         String    @default("")
  postalCode     String    @default("")
  city           String    @default("")
  country        String    @default("DE")
  email          String?
  phone          String?
  vatId          String?
  notes          String?   @db.Text
  leadId         String?
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingId      String?
  booking        Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoices       Invoice[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([leadId])
  @@index([bookingId])
  @@index([name])
  @@map("invoicing_customers")
}

model InvoiceSequence {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("invoicing_sequences")
}

model Invoice {
  id                   String            @id @default(cuid())
  invoiceNumber        String?           @unique
  invoiceYear          Int?
  sequenceNumber       Int?
  type                 InvoiceType       @default(INVOICE)
  status               InvoiceStatus     @default(DRAFT)
  currency             String            @default("EUR")
  taxTreatment         TaxTreatment      @default(STANDARD_19)
  issueDate            DateTime?         @db.Date
  serviceDate          DateTime?         @db.Date
  servicePeriodStart   DateTime?         @db.Date
  servicePeriodEnd     DateTime?         @db.Date
  dueDate              DateTime?         @db.Date
  paymentTermsDays     Int               @default(14)
  customerReference    String?
  buyerReference       String?
  paymentReference     String?
  paymentMeansCode     String            @default("58")
  en16931Profile       String            @default("EN16931-READY")
  notes                String?           @db.Text
  introText            String            @db.Text
  outroText            String            @db.Text
  taxLegalNotice       String?           @db.Text
  subtotalNetCents     Int               @default(0)
  totalDiscountCents   Int               @default(0)
  totalVatCents        Int               @default(0)
  totalGrossCents      Int               @default(0)
  paidAmountCents      Int               @default(0)
  taxBreakdownJson     Json?
  customerId           String
  customer             BillingCustomer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  correctedInvoiceId   String?
  correctedInvoice     Invoice?          @relation("InvoiceCorrections", fields: [correctedInvoiceId], references: [id], onDelete: Restrict)
  corrections          Invoice[]         @relation("InvoiceCorrections")
  issuedAt             DateTime?
  paidAt               DateTime?
  cancelledAt          DateTime?
  issuerSnapshotJson   Json?
  customerSnapshotJson Json?
  itemsSnapshotJson    Json?
  pdfBytes             Bytes?
  pdfSha256            String?
  items                InvoiceItem[]
  payments             InvoicePayment[]
  auditLogs            InvoiceAuditLog[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([invoiceYear, sequenceNumber])
  @@index([status, issueDate])
  @@index([customerId])
  @@index([correctedInvoiceId])
  @@index([dueDate])
  @@map("invoicing_invoices")
}

model InvoiceItem {
  id                String  @id @default(cuid())
  invoiceId         String
  invoice           Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position          Int
  description       String  @db.Text
  quantity          Decimal @db.Decimal(12, 4)
  unit              String  @default("Std.")
  unitCode          String  @default("HUR")
  unitPriceNetCents Int
  discountPercent   Decimal @default(0) @db.Decimal(5, 2)
  discountCents     Int     @default(0)
  vatRateBps        Int     @default(1900)
  vatCategoryCode   String  @default("S")
  lineNetCents      Int

  @@index([invoiceId, position])
  @@map("invoicing_invoice_items")
}

model InvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paidAt      DateTime @db.Date
  amountCents Int
  method      String
  reference   String?
  notes       String?  @db.Text
  recordedBy  String   @default("admin")
  createdAt   DateTime @default(now())

  @@index([invoiceId, paidAt])
  @@map("invoicing_payments")
}

model InvoiceAuditLog {
  id        String             @id @default(cuid())
  invoiceId String
  invoice   Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action    InvoiceAuditAction
  actor     String             @default("admin")
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([invoiceId, createdAt])
  @@map("invoicing_audit_logs")
}
