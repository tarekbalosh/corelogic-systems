# ==============================================================================
# CoreLogic Systems — AI Sales & Consultation Agent Environment Variables
# Copy this file to .env.local for local development. NEVER commit real secrets.
# ==============================================================================

# --- Feature Flags ---
# Master toggle for rendering the floating chat widget ("true" or "false").
# Keep "false" until tested on Vercel Preview and ready to go live.
CHAT_WIDGET_ENABLED="false"

# Master toggle for outbound WhatsApp Cloud API calls ("true" or "false").
# Set "false" in local dev / Vercel Preview if you want to suppress real sends.
WHATSAPP_ENABLED="false"

# --- Anthropic Claude API ---
# Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Claude model identifier from Anthropic Console (never hard-coded in code).
# Example: claude-sonnet-4-5-20250929 or claude-sonnet-4-6
ANTHROPIC_MODEL=""

# --- Database (Neon PostgreSQL + Prisma) ---
# Pooled connection string from Neon (used at runtime on Vercel serverless; includes -pooler / ?pgbouncer=true)
DATABASE_URL=""

# Direct (unpooled) connection string from Neon (required by Prisma CLI for migrations)
DIRECT_URL=""

# --- Meta WhatsApp Business Cloud API ---
# Found in Meta Developer Portal -> App -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=""

# Permanent System User Access Token from Meta Business Settings
WHATSAPP_ACCESS_TOKEN=""

# App Secret from Meta Developer Portal -> App Settings -> Basic (used to verify X-Hub-Signature-256)
WHATSAPP_APP_SECRET=""

# Random secret string you choose and paste into Meta Webhook configuration for GET verification
WHATSAPP_VERIFY_TOKEN=""

# Meta Graph API version (optional; defaults to v21.0)
WHATSAPP_API_VERSION="v21.0"

# Owner WhatsApp number in international digits without '+' (e.g. 601169397149)
# Receives lead alerts, booking Confirm/Reject buttons, escalations, and error alerts
OWNER_WHATSAPP_NUMBER=""

# Optional WhatsApp template language overrides (defaults: ar for owner, conversation language en/ar for customer)
WHATSAPP_OWNER_TEMPLATE_LANG="ar"

# --- Admin Dashboard (/admin) ---
# Long random secret token (at least 32 chars, e.g. `openssl rand -hex 32`) for /admin login & cookie signing
ADMIN_TOKEN=""

# --- Booking & Business Schedule ---
# IANA timezone used to interpret AvailabilityRule hours and format customer slot labels
BUSINESS_TIMEZONE="Asia/Kuala_Lumpur"

# Consultation slot duration in minutes
MEETING_DURATION_MINUTES="30"

# Maximum number of days ahead visitors can view/book consultation slots
BOOKING_WINDOW_DAYS="14"

# --- Cost, Abuse & Privacy Controls ---
# Global daily cap on Anthropic model calls across all visitors (resets daily in BUSINESS_TIMEZONE)
DAILY_MODEL_CALL_LIMIT="200"

# Optional Cloudflare Turnstile bot verification before first chat message ("true" or "false")
BOT_PROTECTION_ENABLED="false"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Days to retain stored conversations and unbooked leads when running scripts/data-retention.ts
DATA_RETENTION_DAYS="180"
